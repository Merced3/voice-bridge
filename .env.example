# voice-bridge configuration — copy to .env and fill in.

# Boot-time diagnostic token reported by GET /boot-check; proves which
# environment the running process actually started with. Optional — the
# service starts without it, but /boot-check answers 503 until it's set.
VOICE_BRIDGE_BOOT_TOKEN=

# Token gating the phone page and both websockets. Empty = local-only
# trust (LAN). Set one before the page leaves the machine's sight.
# Source: self-generated shared secret, e.g. `openssl rand -hex 32`.
# Must match the token the connecting agent (teaching-agent) presents.
VOICE_BRIDGE_TOKEN=

# Bind address. 0.0.0.0 so the phone on the LAN can reach the page.
# Off-LAN access is via Tailscale, never a public tunnel.
VOICE_BRIDGE_HOST=0.0.0.0
VOICE_BRIDGE_PORT=8200

# Seconds without a heartbeat before the button is considered gone.
VOICE_BRIDGE_HEARTBEAT_TIMEOUT=6.0

# Directory for runtime state. Back this up.
VOICE_BRIDGE_DATA_DIR=data
